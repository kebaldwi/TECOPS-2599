---
# Stage-specific device credential secrets. Catalyst Center API credentials
# are stored in the shared encrypted file at ../group_vars/all/vault.yml.
# From Support/Resources/Ansible, copy and encrypt:
#   cp campus-evpn/vaults/device_credentials.yml.example campus-evpn/vaults/device_credentials.yml
#   ansible-vault encrypt campus-evpn/vaults/device_credentials.yml --ask-vault-pass

# These values are merged into the matching device_credentials objects at runtime.
catc_device_credential_secrets:
  cli_credential:
    password: "replace_with_device_password"
    enable_password: "replace_with_enable_password"
  snmp_v2c_read:
    read_community: "replace_with_read_community"
  snmp_v2c_write:
    write_community: "replace_with_write_community"
